{
  "name": "자모 오피스 — 한글·워드·파워포인트",
  "short_name": "자모 오피스",
  "description": "hwp, hwpx, docx, pptx 를 열고 고치는 무료 편집기. 파일은 기기를 떠나지 않습니다.",
  "lang": "ko",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "id": "jamo-office",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f1f2f4",
  "theme_color": "#1e2749",
  "categories": ["productivity", "business", "utilities"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "launch_handler": { "client_mode": "navigate-existing" },
  "file_handlers": [
    {
      "action": "./",
      "launch_type": "single-client",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "accept": {
        "application/hwp+zip": [".hwpx"],
        "application/x-hwp": [".hwp"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"]
      }
    }
  ],
  "shortcuts": [
    { "name": "새 한글 문서", "url": "./?new=hwpx", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "새 워드 문서", "url": "./?new=docx", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "새 슬라이드", "url": "./?new=pptx", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
