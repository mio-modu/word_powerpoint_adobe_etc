{
  "name": "jamo-office",
  "version": "0.1.0",
  "private": true,
  "description": "브라우저에서 바로 여는 무료 오피스 — 한글(hwp/hwpx) 우선, 이후 Word/PowerPoint",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev --workspace @jamo/editor",
    "build:web": "npm run build --workspace @jamo/editor && vite-node scripts/build-pwa.mts -- apps/editor/dist",
    "samples": "vite-node scripts/emit-samples.mts -- samples && vite-node scripts/emit-old-hwp.mts -- samples",
    "inspect": "vite-node scripts/inspect-cfb.mts --",
    "test:e2e": "node apps/editor/e2e/smoke.mjs",
    "preview": "vite preview --outDir apps/editor/dist --port 4173",
    "build:single": "npm run build:web && vite-node scripts/bundle-single-file.mts -- apps/editor/dist",
    "test:e2e:file": "node apps/editor/e2e/single-file.mjs",
    "test:e2e:edit": "node apps/editor/e2e/editing.mjs",
    "verify:real": "vite-node scripts/verify-real-file.mts --",
    "test:e2e:table": "node apps/editor/e2e/table-ui.mjs",
    "build:icons": "node scripts/make-icons.mjs",
    "test:e2e:slides": "node apps/editor/e2e/slideshow.mjs",
    "test:e2e:pwa": "node apps/editor/e2e/pwa.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vite": "^6.0.5",
    "@vitejs/plugin-react": "^4.3.4"
  }
}
